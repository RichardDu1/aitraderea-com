---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy | AITrader EA">
  <div class="container max-w-3xl mx-auto px-6 py-24 prose prose-invert prose-primary">
    <h1>Privacy Policy</h1>
    <p>Last updated: {new Date().toLocaleDateString()}</p>
    <p>Your privacy is important to us at AITrader EA. This Privacy Policy explains how we collect, use, and protect your information.</p>
    <h2>Information We Collect</h2>
    <p>We only collect email addresses when you voluntarily subscribe to our newsletter. We use cookies and analytics tools to understand website traffic.</p>
    <h2>How We Use Your Information</h2>
    <p>Your email is used strictly for sending our newsletter. We will never sell or share your data with third parties.</p>
    <h2>Affiliate Tracking</h2>
    <p>When you click on an outbound link, a tracking cookie may be placed in your browser to attribute sales to our affiliate accounts.</p>
  </div>
</BaseLayout>