---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allItems = await getCollection("eas");
---

<BaseLayout title="All EAs | AITrader EA">
  <div class="bg-surface text-text min-h-screen py-24">
    <div class="container max-w-6xl mx-auto px-6">
      <h1 class="text-4xl md:text-6xl font-black mb-16">All EAs</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allItems.map(item => (
          <a href={`/eas/${item.id}`} class="bg-neutral rounded-2xl border border-border p-8 hover:border-primary transition-colors shadow-lg">
            <h3 class="text-2xl font-black text-text mb-2">{item.data.title || item.id}</h3>
            <p class="text-muted leading-relaxed mb-6">{(item.data.description || "").substring(0, 100)}...</p>
            <div class="text-green-500 font-bold">Read Full Review →</div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>