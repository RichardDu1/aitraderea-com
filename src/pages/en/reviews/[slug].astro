---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(review => ({
    params: { slug: review.id.split('/').pop() },
    props: { review },
  }));
}

const { review } = Astro.props;
const { Content } = await render(review);

// Schema Markup for Product Review
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "SoftwareApplication",
    "name": review.data.title,
    "applicationCategory": "Algorithmic Trading EA"
  },
  "author": {
    "@type": "Organization",
    "name": "AI Trade Area"
  },
  "description": review.data.description,
  "datePublished": review.data.publishedAt
};
---

<BaseLayout
  title={`${review.data.title} EA Review & Backtest | AI Trade Area`}
  description={review.data.description}
  canonical={`https://aitraderea.com/en/reviews/${review.id.split('/').pop()}/`}
  schema={{ type: 'Review', data: reviewSchema }}
>
  <article class="max-w-[900px] mx-auto px-6 pt-32 pb-24">
    <!-- Breadcrumbs -->
    <nav class="mb-10 flex items-center text-sm font-medium text-muted gap-2 font-mono">
      <a href="/en/reviews/" class="hover:text-primary transition-colors">~/reviews</a>
      <span>/</span>
      <span class="text-primary">{review.data.strategyType.toLowerCase()}</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 border border-primary/30 bg-primary/10 rounded text-xs font-mono text-primary">
        MQL5 Verified Data
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-[1.1] mb-6 text-[#E6F1FF]">{review.data.title}</h1>
      <p class="text-xl text-muted max-w-2xl leading-relaxed mb-8">{review.data.description}</p>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pb-8 border-b border-[#233554]">
        <div class="glass-card p-4 rounded-lg border border-[#233554]">
          <span class="text-[10px] uppercase tracking-wider text-muted font-bold mb-1 block">Monthly Yield</span>
          <span class="text-2xl font-bold text-green-400">{review.data.monthlyYield}</span>
        </div>
        <div class="glass-card p-4 rounded-lg border border-[#233554]">
          <span class="text-[10px] uppercase tracking-wider text-muted font-bold mb-1 block">Max Drawdown</span>
          <span class="text-2xl font-bold text-red-400">{review.data.maxDrawdown}</span>
        </div>
        <div class="glass-card p-4 rounded-lg border border-[#233554]">
          <span class="text-[10px] uppercase tracking-wider text-muted font-bold mb-1 block">Platform</span>
          <span class="text-lg font-bold text-white">{review.data.platform}</span>
        </div>
        <div class="glass-card p-4 rounded-lg border border-[#233554]">
          <span class="text-[10px] uppercase tracking-wider text-muted font-bold mb-1 block">License Price</span>
          <span class="text-lg font-bold text-white">{review.data.price}</span>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <!-- The Bottom Line (Executive Summary) -->
        <div class="glass-card p-6 rounded-2xl border-l-4 border-l-primary mb-12">
          <h2 class="text-xl font-bold mb-3 text-white">Algorithmic Edge (Bottom Line)</h2>
          <p class="text-muted leading-relaxed">{review.data.bottomLine}</p>
          <div class="mt-6 flex flex-wrap gap-4">
            {review.data.mql5Url && (
              <a href={review.data.mql5Url} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-[#0A192F] px-6 py-2 rounded font-bold transition-colors text-sm shadow-[0_0_10px_rgba(100,255,218,0.2)]">
                View on MQL5
              </a>
            )}
            {review.data.myfxbookUrl && (
              <a href={review.data.myfxbookUrl} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-2 border border-[#233554] hover:border-primary text-white px-6 py-2 rounded font-bold transition-colors text-sm bg-[#112240]">
                Live MyFxBook
              </a>
            )}
          </div>
        </div>

        <div class="prose prose-invert prose-lg max-w-none 
          prose-headings:font-bold prose-headings:text-[#E6F1FF]
          prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:border-b prose-h2:border-[#233554] prose-h2:pb-4
          prose-h3:text-2xl prose-h3:mt-8
          prose-p:text-muted prose-p:leading-relaxed
          prose-a:text-primary hover:prose-a:underline">
          <Content />
        </div>
      </div>

      <!-- Sidebar (Pros/Cons) -->
      <aside class="lg:col-span-1 space-y-8">
        <div class="glass-card p-6 rounded-2xl border-t-2 border-t-green-500">
          <h3 class="text-lg font-bold mb-4 flex items-center gap-2 text-white">
            <span class="text-green-500">✓</span> Strengths
          </h3>
          <ul class="space-y-3">
            {review.data.pros.map(pro => (
              <li class="text-sm text-muted flex items-start gap-2">
                <span class="text-green-500 mt-0.5 font-bold">+</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="glass-card p-6 rounded-2xl border-t-2 border-t-red-500">
          <h3 class="text-lg font-bold mb-4 flex items-center gap-2 text-white">
            <span class="text-red-500">✗</span> Weaknesses
          </h3>
          <ul class="space-y-3">
            {review.data.cons.map(con => (
              <li class="text-sm text-muted flex items-start gap-2">
                <span class="text-red-500 mt-0.5 font-bold">-</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="glass-card p-6 rounded-2xl border border-[#233554]">
           <h3 class="text-sm font-bold mb-2 text-white uppercase tracking-wider">Developer</h3>
           <p class="text-primary font-mono text-sm">{review.data.developer}</p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
