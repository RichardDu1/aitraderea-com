---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allReviews = await getCollection('reviews');
const sortedReviews = allReviews.sort((a, b) => {
  // Sort by highest yield or just alphabetical if missing
  const parseYield = (y) => parseFloat(y.replace(/[^0-9.]/g, '')) || 0;
  return parseYield(b.data.monthlyYield) - parseYield(a.data.monthlyYield);
});

const topEAs = sortedReviews.slice(0, 3);

const pageTitle = 'Data-Driven MT4/MT5 EA Reviews | AI Trade Area';
const pageDescription = 'Real-time leaderboard and verified MyFxBook tracking for the most profitable Expert Advisors.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://aitraderea.com/en/"
  schema={{ type: 'WebSite', data: { description: pageDescription } }}
>
  <!-- Modern SaaS Hero with 3D Dashboard Mock -->
  <header class="relative overflow-hidden pt-24 pb-32">
    <!-- Abstract Tech Background -->
    <div class="absolute inset-0 z-0 opacity-20">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#233554" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
      <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
    </div>

    <div class="container max-w-7xl mx-auto relative z-10 flex flex-col lg:flex-row items-center gap-16 px-6">
      <div class="lg:w-1/2 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 border border-primary/30 bg-primary/10 rounded text-xs font-mono text-primary">
          <svg class="w-4 h-4 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          MQL5 API Sync Active
        </div>
        <h1 class="text-5xl md:text-7xl font-extrabold text-[#E6F1FF] mb-6 leading-[1.1]">
          Stop guessing. <br/>
          Start trading with <span class="text-primary">data</span>.
        </h1>
        <p class="text-xl text-muted leading-relaxed mb-10 max-w-lg">
          We reverse-engineer the most popular MT4/MT5 Expert Advisors, linking them to verified live MyFxBook data so you never blow another account.
        </p>
        <div class="flex gap-4">
          <a href="/en/reviews/" class="px-8 py-4 bg-primary text-[#0A192F] font-bold rounded hover:bg-primary-dark transition-colors shadow-[0_0_15px_rgba(100,255,218,0.4)] inline-block">
            Explore Leaderboard
          </a>
        </div>
      </div>

      <!-- 3D SaaS Dashboard Mock -->
      <div class="lg:w-1/2 w-full perspective-1000">
        <div class="glass-card rounded-xl overflow-hidden shadow-2xl transform rotate-y-[-10deg] rotate-x-[5deg] hover:rotate-y-0 hover:rotate-x-0 transition-transform duration-700 ease-out border border-[#233554]">
          <!-- Browser Bar -->
          <div class="bg-[#020C1B] px-4 py-3 flex items-center border-b border-[#233554]">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            <div class="mx-auto bg-[#112240] text-muted text-xs px-24 py-1 rounded-md border border-[#233554]">app.aitraderea.com</div>
          </div>
          
          <!-- Mock Chart UI -->
          <div class="p-6">
            <div class="flex justify-between items-end mb-6">
              <div>
                <h3 class="text-white font-bold text-lg">Perceptrader AI (Live)</h3>
                <p class="text-primary font-mono text-sm mt-1">+245.8% ROI (All Time)</p>
              </div>
              <div class="bg-[#112240] px-3 py-1 rounded text-xs font-bold text-white border border-[#233554]">MyFxBook Verified</div>
            </div>
            
            <!-- SVG Mock Line Chart -->
            <div class="h-40 w-full relative">
              <svg viewBox="0 0 500 150" class="w-full h-full preserve-aspect-ratio-none">
                <defs>
                  <linearGradient id="grad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#64FFDA" stop-opacity="0.4"/>
                    <stop offset="100%" stop-color="#64FFDA" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0,150 L0,100 C50,110 100,50 150,60 C200,70 250,20 300,40 C350,60 400,10 450,20 C480,25 500,5 500,5 L500,150 Z" fill="url(#grad)" />
                <path d="M0,100 C50,110 100,50 150,60 C200,70 250,20 300,40 C350,60 400,10 450,20 C480,25 500,5 500,5" fill="none" stroke="#64FFDA" stroke-width="3" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Leaderboard Section -->
  <section class="max-w-7xl mx-auto px-6 py-20 border-t border-[#233554]">
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-3xl font-bold text-[#E6F1FF]">Top Performing Algorithms</h2>
      <a href="/en/reviews/" class="text-primary hover:underline text-sm font-bold flex items-center gap-1">
        View Full Leaderboard <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {topEAs.length > 0 ? topEAs.map((ea, idx) => (
        <a href={`/en/reviews/${ea.id.split('/').pop()}`} class="glass-card rounded-xl p-6 hover:-translate-y-1 transition-transform group border border-[#233554] hover:border-primary relative overflow-hidden">
          {idx === 0 && <div class="absolute top-0 right-0 bg-primary text-[#0A192F] text-xs font-bold px-3 py-1 rounded-bl-lg">#1 Yield</div>}
          
          <div class="flex justify-between items-start mb-4">
            <span class="text-xs font-medium px-2 py-1 rounded bg-[#112240] text-primary border border-[#233554]">
              {ea.data.strategyType}
            </span>
          </div>
          <h3 class="text-2xl font-bold mb-1 text-white group-hover:text-primary transition-colors">{ea.data.title}</h3>
          <p class="text-xs text-muted mb-6">by {ea.data.developer}</p>
          
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="bg-[#020C1B] p-3 rounded-lg border border-[#233554]">
              <div class="text-[10px] text-muted uppercase tracking-wider mb-1">Monthly Yield</div>
              <div class="text-lg font-bold text-green-400">{ea.data.monthlyYield}</div>
            </div>
            <div class="bg-[#020C1B] p-3 rounded-lg border border-[#233554]">
              <div class="text-[10px] text-muted uppercase tracking-wider mb-1">Max Drawdown</div>
              <div class="text-lg font-bold text-red-400">{ea.data.maxDrawdown}</div>
            </div>
          </div>
        </a>
      )) : (
        <div class="col-span-3 text-center py-12 glass-card rounded-xl border border-[#233554]">
          <h3 class="text-xl font-bold text-muted">Awaiting MQL5 Data Sync...</h3>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
