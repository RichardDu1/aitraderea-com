---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';

const pageTitle = 'AI Trader EA — Automated Trading Systems & Expert Advisors';
const pageDescription = 'Download and review the best MetaTrader 4/5 Expert Advisors (EAs) and AI Trading Bots.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://aitraderea.com/en/"
  schema={{ type: 'WebSite', data: { description: pageDescription } }}
>
  <Hero title="Automate Your Trading with AI EAs" subtitle="Verified MQL4/MQL5 Expert Advisors with live MyFxBook track records." />

  <section class="container mx-auto px-6 py-8 animate-fade-in-up" style="animation-delay: 0.2s;">
    <h2 class="text-xl md:text-2xl font-bold mb-10 text-white tracking-tight flex items-center gap-3">
      <span class="w-1.5 h-6 bg-primary-500 rounded-full"></span>
      Popular Categories
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-fr">
      <Card title="MT4 EAs" description="Best MetaTrader 4 Bots" href="/en/categories/c1/" tag="Trending" featured={true} />
      <Card title="MT5 EAs" description="Advanced MT5 Algorithms" href="/en/categories/c2/" tag="New" />
      <Card title="Scalping" description="High-frequency Scalpers" href="/en/categories/c3/" />
      <Card title="Prop Firm EAs" description="EAs to pass FTMO" href="/en/categories/c4/" />
    </div>
  </section>

  <section class="container mx-auto px-6 py-16 animate-fade-in-up" style="animation-delay: 0.4s;">
    <h2 class="text-xl md:text-2xl font-bold mb-10 text-white tracking-tight flex items-center gap-3">
      <span class="w-1.5 h-6 bg-purple-500 rounded-full"></span>
      Latest Updates
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card title="Top 5 Grid Trading EAs" description="Read our latest in-depth review and analysis for 2026." href="/en/reviews/1/" rating={4.9} price="Verified" />
      <Card title="Review: Waka Waka EA" description="A comprehensive breakdown of features, pricing, and pros/cons." href="/en/reviews/2/" rating={4.7} price="Top Choice" />
      <Card title="Best News Trading Bots" description="Everything you need to know before making a decision." href="/en/reviews/3/" rating={4.5} price="Updated" />
    </div>
  </section>
</BaseLayout>
