---
// HTML Sitemap — helps crawlers discover all pages
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Sitemap — AI TraderEA';
const description = 'Complete list of all pages on AI TraderEA.';

const pages = [
  { label: 'Home', href: '/' },
  { label: 'EA Leaderboard', href: '/eas/' },
  { label: 'EA Comparisons', href: '/comparison/' },
  { label: 'Best EA Lists', href: '/best/' },
  { label: 'Prop Firm Challenge EAs', href: '/prop-challenges/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'How We Rate', href: '/how-we-rate/' },
  { label: 'About', href: '/about/' },
  { label: 'Privacy Policy', href: '/privacy/' },
  { label: 'Terms of Service', href: '/terms/' },
];
---

<BaseLayout title={title} description={description}>
  <section class="container mx-auto px-6 py-20 max-w-3xl">
    <h1 class="text-4xl font-black text-text mb-8">Sitemap</h1>
    <ul class="space-y-3">
      {pages.map((p) => (
        <li>
          <a href={p.href} class="text-primary hover:text-primary-light font-medium transition-colors">{p.label}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>