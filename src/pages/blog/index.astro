---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await getCollection("blog");
allPosts.sort((a, b) => {
  const dateA = a.data.publishedAt ? new Date(a.data.publishedAt).getTime() : 0;
  const dateB = b.data.publishedAt ? new Date(b.data.publishedAt).getTime() : 0;
  return dateB - dateA;
});
---

<BaseLayout title="Algorithmic Trading Guides & Insights | AI TraderEA" description="Expert insights, tutorials, and guides on MT4/MT5 Expert Advisors, algorithmic trading, and prop firm challenges." canonical="https://aitraderea.com/blog/">
  <div class="container mx-auto px-6 py-20">
    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-black text-text mb-4">Blog & Insights</h1>
      <p class="text-slate-400 text-lg max-w-2xl">Expert insights, tutorials, and guides to help you trade smarter with Expert Advisors.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allPosts.map(post => (
        <a href={`/blog/${post.id}`} class="bg-neutral/50 border border-border rounded-2xl p-8 hover:border-primary/30 transition-all hover:-translate-y-1 group">
          <div class="text-xs text-slate-500 mb-3 font-bold uppercase tracking-widest">{post.data.author || 'Editorial Team'}</div>
          <h3 class="text-2xl font-bold text-text mb-4 group-hover:text-primary transition-colors">{post.data.title || post.id}</h3>
          <p class="text-slate-400 leading-relaxed mb-6">{(post.data.description || "").substring(0, 150)}...</p>
          <div class="text-primary font-bold">Read Article →</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>